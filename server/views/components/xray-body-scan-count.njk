{% macro xrayBodyScanCount(arrival) %}
{% set atLimit = arrival.bodyScanStatus === 'DO_NOT_SCAN' %}
{% set nearingLimit = arrival.bodyScanStatus === 'CLOSE_TO_LIMIT' %}
<div class="xray-body-scan-count {% if atLimit %}xray-body-scan-count--at-limit{% elif nearingLimit %}xray-body-scan-count--nearing-limit{% endif %}">
    <div class="xray-body-scan-count__number">
        {% set countDescription %}
            {% if arrival.numberOfBodyScans == 0 %}
                No scans recorded
            {% elif arrival.numberOfBodyScans == 1 %}
                1 scan this year
            {% else %}
                {{ arrival.numberOfBodyScans }} scans this year
            {% endif %}
        {% endset %}
        <span aria-label="{{ countDescription }}">{{ arrival.numberOfBodyScans }}</span>
    </div>
    {% if atLimit %}
        <strong class="xray-body-scan-count__limit-warning">Scan limit reached</strong>
        No more scans allowed this year<span class="govuk-visually-hidden">.</span>
    {% elif nearingLimit %}
        <strong class="xray-body-scan-count__limit-warning">Near scan limit</strong>
        {{ arrival.numberOfBodyScansRemaining }} {{ 'scan' if arrival.numberOfBodyScansRemaining == 1 else 'scans' }} left this year<span class="govuk-visually-hidden">.</span>
    {% elif arrival.numberOfBodyScans == 0 %}
        <span aria-hidden="true">No scans recorded</span>
    {% endif %}
</div>
{% endmacro %}
