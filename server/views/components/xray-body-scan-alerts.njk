{% macro xrayBodyScanAlerts(relevantAlerts) %}
    {% if relevantAlerts and relevantAlerts.length %}
        <ul class="govuk-list govuk-!-margin-top-1">
            {% for alert in relevantAlerts %}
                <li>
                    <div class="dps-alert-status dps-alert-status--{{ alert.type }}">
                        {% if alert.code == 'XIS' %}
                            Internal secretor
                        {% elseif alert.code == 'XXRAY' %}
                            Do not X-ray body scan
                        {% else %}
                            {{ alert.codeDescription }}
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}
